# ==============================================================================
# CITYPULSE SMART CITY INTELLIGENCE PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE ZERO-KEY SERVICES (ALWAYS FUNCTIONAL WITHOUT ANY API KEY)
# ------------------------------------------------------------------------------
# The following features operate out-of-the-box using direct open APIs:
# - Open-Meteo High-Resolution Atmospheric & Weather Forecasts (worldwide)
# - Open-Meteo Copernicus CAMS Air Quality Telemetry (PM2.5, PM10, AQI, O3, NO2)
# - OpenStreetMap Nominatim Facility Geocoding (hospitals, schools, police, etc.)
# - OSRM Road Topology & Routing Machine (real road-network routes & duration)
# - National Weather Service (NWS) Active Emergency Bulletins (US coordinates)
# - CartoDB Dark Matter GIS Cartography Tiles

# ------------------------------------------------------------------------------
# 2. SUPABASE (OPTIONAL — FOR USER ACCOUNTS & CROSS-DEVICE SEARCH HISTORY)
# ------------------------------------------------------------------------------
# If left blank, the platform stores bookmarks and settings locally in browser localStorage.
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 3. TOMTOM LIVE TRAFFIC TELEMETRY (OPTIONAL — FOR ROAD PROBE FLOW TILES & INCIDENTS)
# ------------------------------------------------------------------------------
# Free tier key can be generated at: https://developer.tomtom.com
# Enables road-level green/yellow/red traffic flow raster tiles and live incident details.
# If omitted, the platform gracefully indicates telemetry status without fabricating fake data.
VITE_TOMTOM_API_KEY=

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI ASSISTANT (OPTIONAL — FOR ADVANCED NATURAL LANGUAGE CHAT)
# ------------------------------------------------------------------------------
# Free tier key can be generated at: https://aistudio.google.com
# Enables Google Gemini AI reasoning with full tool calling for city intelligence.
# If omitted, the assistant operates with the built-in deterministic geospatial tool engine.
VITE_GEMINI_API_KEY=
